VITE_FIREBASE_API_KEY="AIzaSyAnXY8vD9N8S30xFnjChBzCdudxFAeQZ9s"
VITE_FIREBASE_AUTH_DOMAIN="anonconnect-e1b76.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://anonconnect-e1b76-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="anonconnect-e1b76"
VITE_FIREBASE_APP_ID="1:221431965489:web:f49e40ec0ca98b9a66f210"

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAnXY8vD9N8S30xFnjChBzCdudxFAeQZ9s"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="anonconnect-e1b76.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://anonconnect-e1b76-default-rtdb.firebaseio.com"

# GEMINI_API_KEY: Required for optional AI Icebreaker feature (Gemini 3.1 Pro Preview with high thinking)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Firebase Client Configuration (Spark Plan - Realtime Database & Anonymous Auth)
